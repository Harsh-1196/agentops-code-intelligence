# AgentOps Configuration Environment Template
# Copy this file to .env and configure your values

# External LLM Provider (Google AI Studio Gemini API)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# Agent Orchestration Settings
MAX_AGENT_ITERATIONS=3
AGENT_TIMEOUT_SECONDS=120
EVAL_STRICTNESS=strict

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OpenTelemetry & Jaeger Distributed Tracing
OTEL_SERVICE_NAME=agentops-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_TRACES_SAMPLER=always_on
JAEGER_UI_URL=http://localhost:16686

# Persistence
DATABASE_URL=sqlite:///./agentops.db

# Live Inference vs Fixture Fallback
ALLOW_MOCK_FALLBACK=true
